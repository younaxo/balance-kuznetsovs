# Скопируйте этот файл в .env (или .env.local) и заполните значения.
# Реальные секреты никогда не должны попадать в git.

# --- База данных -------------------------------------------------------
# Строка подключения PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balance_kuznetsovs"

# --- Сессии администратора ----------------------------------------------
# Случайная строка не короче 32 символов, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-64-character-hex-string"

# --- Bootstrap первого администратора ------------------------------------
# Используются ТОЛЬКО скриптом `npm run seed:admin`. После создания
# администратора эти переменные можно удалить из .env.
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="change-me-strong-password"

# --- Telegram-уведомления о заявках --------------------------------------
# Токен бота из @BotFather и chat_id получателя уведомлений.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- SMTP-уведомления о заявках ------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@example.com"
APPLICATION_EMAIL_TO="office@example.com"

# --- Cloudflare Turnstile (антиспам) -------------------------------------
# Если оставить пустым — виджет Turnstile на форме не показывается
# и серверная проверка пропускается (для локальной разработки).
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Аналитика ------------------------------------------------------------
# Соль для соления IP перед хешированием (rate limiting), не для маркетинга.
ANALYTICS_IP_HASH_SALT="change-me-to-a-random-string"

# Публичный идентификатор счётчика Яндекс.Метрики. Если пусто — счётчик
# не подключается, сайт продолжает работать без ошибок.
NEXT_PUBLIC_YANDEX_METRICA_ID=""

# --- Прочее -----------------------------------------------------------
# Публичный адрес сайта (используется для canonical/OG-ссылок).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
